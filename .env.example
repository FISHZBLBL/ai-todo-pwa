# Frontend: production API origin, e.g. https://api.example.com/api
VITE_API_URL=
VITE_VAPID_PUBLIC_KEY=

# Backend
PORT=8787
CORS_ORIGIN=http://localhost:5173
PASSWORD_HASH=
JWT_SECRET=
AI_PROVIDER=deepseek
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
DATA_FILE=./data/todo.json
STORAGE_ADAPTER=file
# PostgreSQL 环境使用 cloudbase-postgres；API Key 仅放在云函数环境变量中
# CLOUDBASE_ENV_ID=your-env-id
CLOUDBASE_APIKEY=
CLOUDBASE_REGION=ap-shanghai
CLOUDBASE_COLLECTION=ai_todo_state
CLOUDBASE_DOCUMENT_ID=single-user-state
CLOUDBASE_STATE_PATH=ai-todo/state.json
# Netlify + 腾讯 COS 推荐配置（私有存储桶）
COS_BUCKET=
COS_REGION=ap-shanghai
COS_SECRET_ID=
COS_SECRET_KEY=
COS_STATE_KEY=ai-todo/state.json
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Starter/Free 方案在 Netlify 项目 Async Workloads 设置中创建
AWL_API_KEY=
APP_TIMEZONE=Asia/Shanghai
