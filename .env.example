# Local development requires Node.js 22+.
# Copy to .env.local; dev:server/server load it with --env-file-if-exists.
# Frontend: leave blank for Vite /api proxy or same-origin Netlify API.
# For a separate deployed API, set e.g. https://api.example.com/api.
VITE_API_URL=
# Legacy only: the current frontend reads the runtime public key from /api/push/config.
VITE_VAPID_PUBLIC_KEY=

# Backend: generate PASSWORD_HASH and a random JWT_SECRET before starting.
# Keep private variables on the server; never add a VITE_ prefix to secrets.
PORT=8787
CORS_ORIGIN=http://localhost:5173
PASSWORD_HASH=
JWT_SECRET=
AI_PROVIDER=deepseek
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
DATA_FILE=./data/todo.json
STORAGE_ADAPTER=file
# Writable adapters: file (persistent disk), cos, cloudbase (transactions),
# cloudbase-postgres (version CAS; absent singleton row initializes by insert).
# cloudbase-storage reads legacy objects only and rejects every mutation.
# CloudBase adapters require CLOUDBASE_ENV_ID; PostgreSQL also needs API Key.
CLOUDBASE_ENV_ID=
CLOUDBASE_APIKEY=
CLOUDBASE_REGION=ap-shanghai
CLOUDBASE_COLLECTION=ai_todo_state
CLOUDBASE_DOCUMENT_ID=single-user-state
CLOUDBASE_STATE_PATH=ai-todo/state.json
# COS: private bucket that has NEVER enabled versioning (not Suspended).
# CAM credentials need object read/write/delete plus cos:GetBucketVersioning.
# Uncertain state PUTs retain ${COS_STATE_KEY}.lock. Stop all writers and
# confirm previous requests have ended before an administrator removes it.
COS_BUCKET=
COS_REGION=ap-shanghai
COS_SECRET_ID=
COS_SECRET_KEY=
COS_STATE_KEY=ai-todo/state.json
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Event-driven Cloudflare Durable Object Alarm service (no cron or idle scan).
# Backend configuration: HTTPS Worker origin only, without a path/query/secret.
# Local development may use an http://localhost origin.
REMINDER_SCHEDULER_URL=
# Generate 32 random bytes, e.g. randomBytes(32).toString('hex').
# Set the SAME value as the Worker's REMINDER_SCHEDULER_SECRET secret.
# Keep it separate from JWT_SECRET, at least 32 characters, no whitespace.
# Never use a VITE_ prefix for either private scheduler configuration value.
REMINDER_SCHEDULER_SECRET=
# Worker-only configuration lives in cloudflare/reminder-alarm/wrangler.jsonc:
# REMINDER_CALLBACK_URL=https://<production-api>/api/reminders/deliver
# Existing deployments: retire this site's old Netlify queue functions first,
# then explicitly POST /api/reminders/bootstrap; see README migration steps.
# Empty queues delete their Alarm. Transient failures retry only real events,
# with exponential backoff capped at one hour. No scheduled maintenance exists.
APP_TIMEZONE=Asia/Shanghai
