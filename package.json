    "@netlify/aws-lambda-compat": "^2.0.0",
    "@netlify/functions": "^5.3.0",
    "@vite-pwa/assets-generator": "^1.0.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "idb": "^8.0.3",
    "jsonwebtoken": "^9.0.2",
